//Una tienda ofrece un descuento del 15 % sobre el total de la compra
//y un cliente desea saber cua?nto debera? pagar finalmente por esta.

Algoritmo Problema_5
	
	Definir valor_compra, descuento Como Real
	
	Escribir "Cuanto fue el valor total de su compra: "
	Leer valor_compra
	
	descuento <- valor_compra*0.85
	
	Escribir "tras el descuento su compra queda en: " descuento
	
FinAlgoritmo
