//Calcule e imprima la suma, el producto y el promedio de estos.

Algoritmo tres_nums
	
	Definir c1,c2,c3, sum como Entero
	
	Escribir "Ingrese 3 numeros separados por enter: "
	Leer c1
	leer c2
	Leer c3
	
	sum <- c1+c2+c3
	
	Escribir "Esta es la suma de los tres numeros: " sum
	Escribir "Este es el producto: " c1*c2*c3
	Escribir "Este es el promedio: " (sum)/3
	
	
	
FinAlgoritmo
