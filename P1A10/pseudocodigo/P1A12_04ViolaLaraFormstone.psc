//lara formstone
// suma de dos numeros pares comprendidos entre 2 y 100

Algoritmo P1A12_04ViolaLaraFormstone
	
	definir suma, num Como Entero
	
	suma <- 2
	num <- 4
	
	Repetir
        suma <- suma + num
        num <- num + 2
    Hasta Que num <=100
	
	Escribir "la suma de los numeros es: " suma
	
FinAlgoritmo
