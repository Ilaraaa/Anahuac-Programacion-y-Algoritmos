Algoritmo circuito1
	
	definir p,q  Como Logico
	
	// 1
	p<- Verdadero
	q<- Verdadero
	
	Escribir "p es: ", p, " -", " q es: ", q
	Escribir "tabla de verdad"
	Escribir p y q, "-", no q, "-", (p y q) o (no q)
	escribir ""
	
	//2
	p<- Verdadero
	q<- Falso
	
	Escribir "p es: ", p, " -", " q es: ", q
	Escribir "tabla de verdad"
	Escribir p y q, "-", no q, "-", (p y q) o (no q)
	escribir ""
	
	//3
	p<- Falso
	q<- Verdadero
	
	Escribir "p es: ", p, " -", " q es: ", q
	Escribir "tabla de verdad"
	Escribir p y q, "-", no q, "-", (p y q) o (no q)
	escribir ""
	
	//4
	p<- Falso
	q<- Falso
	
	Escribir "p es: ", p, " -", " q es: ", q
	Escribir "tabla de verdad"
	Escribir p y q, "-", no q, "-", (p y q) o (no q)
	escribir ""
	
FinAlgoritmo
